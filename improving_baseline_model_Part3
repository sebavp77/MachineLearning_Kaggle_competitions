    "all_nn_dists = np.array(all_nn_dists)\n",
    "p10 = np.percentile(all_nn_dists,10)\n",
    "median = np.median(all_nn_dists)\n",
    "p90 = np.percentile(all_nn_dists,90)\n",
    "print(f\"voxel_size (Z,Y,X) per video: {all_voxel_sizes}\")\n",
